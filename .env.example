# Template only. No real env file is committed — copy this to a gitignored
# `.env.*.local` if you need to override the defaults.
#
#   .env.development.local   overrides `npm run dev`    (gitignored)
#   .env.production.local    overrides `npm run build`  (gitignored)
#
# You usually need NEITHER. src/lib/api.ts defaults per mode: dev builds point
# at localhost, production builds at the deployed backend. A fresh clone and CI
# therefore build correctly with no env file present.
#
# Do NOT add a plain `.env` or `.env.local` — Vite loads those in EVERY mode,
# production builds included, which is how localhost once shipped to
# qantonic.arkaiver.com. Always use the mode-scoped `.local` variants.
#
# Every var here is inlined into the client bundle by Vite and is therefore
# public. Never put a secret in a `VITE_*` var.

VITE_API_BASE_URL=http://localhost:8000
