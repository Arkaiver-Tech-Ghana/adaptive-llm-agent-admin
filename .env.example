# Env files are mode-scoped so a local override can never leak into a build.
#
#   .env.development        loaded by `npm run dev`   (committed)
#   .env.production         loaded by `npm run build` (committed)
#   .env.*.local            your personal override    (gitignored)
#
# Do NOT add a plain `.env.local` — Vite loads it in EVERY mode, production
# builds included, which is how localhost once shipped to qantonic.arkaiver.com.
# To point local dev somewhere else, use `.env.development.local`.

VITE_API_BASE_URL=http://localhost:8000
