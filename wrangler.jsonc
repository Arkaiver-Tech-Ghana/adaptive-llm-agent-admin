{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qantonic",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "qantonic.arkaiver.com", "custom_domain": true }
  ]
}
